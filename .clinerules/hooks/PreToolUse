#!/usr/bin/env bash
# Cline commit gate: run checks for the staged code surface only.
set -uo pipefail

FLUTTER="/data/projects/flutter/bin/flutter"
input=$(cat)
tool=$(printf '%s' "$input" | jq -r '.preToolUse.toolName // empty')
cmd=$(printf '%s' "$input" | jq -r '.preToolUse.parameters.command // empty')
root=$(printf '%s' "$input" | jq -r '.workspaceRoots[0] // "."')
[[ -n "$cmd" ]] || cmd=$(printf '%s' "$input" | jq -c '.preToolUse.parameters // {}')
if [[ "$tool" != "execute_command" ]] || [[ "$cmd" != *"git commit"* ]]; then
  echo '{"cancel": false}'
  exit 0
fi
cd "$root" 2>/dev/null || { echo '{"cancel": false}'; exit 0; }

mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR)
if ((${#staged[@]} == 0)); then
  echo '{"cancel": true, "errorMessage": "BLOCKED: no staged files."}'
  exit 0
fi
need_flutter=false
need_rust=false
for f in "${staged[@]}"; do
  case "$f" in
    lib/*|test/*|pubspec.yaml|pubspec.lock|analysis_options.yaml|l10n.yaml) need_flutter=true ;;
    native/*.toml|native/*.lock|native/src/*) need_rust=true ;;
  esac
done
if $need_flutter && { ! "$FLUTTER" analyze || ! "$FLUTTER" test; }; then
  echo '{"cancel": true, "errorMessage": "BLOCKED: Flutter analyze or complete test suite failed."}'
  exit 0
fi
if $need_rust && ! (cd native && cargo build && cargo test); then
  echo '{"cancel": true, "errorMessage": "BLOCKED: Rust build or test failed."}'
  exit 0
fi
echo '{"cancel": false, "contextModification": "GATE PASSED: staged code surfaces verified."}'
