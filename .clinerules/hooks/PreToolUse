#!/usr/bin/env bash
# Gate: block `git commit` unless flutter analyze + flutter test both pass.
# Requires jq. If "flutter: not found", set FLUTTER to its full path.

FLUTTER="/data/projects/flutter/bin/flutter"   # e.g. /home/USER/flutter/bin/flutter

input=$(cat)

tool=$(echo "$input" | jq -r '.preToolUse.toolName // empty')
cmd=$(echo "$input"  | jq -r '.preToolUse.parameters.command // empty')
root=$(echo "$input" | jq -r '.workspaceRoots[0] // "."')

# Fallback: if the command field is named differently, scan raw params.
if [[ -z "$cmd" ]]; then
  cmd=$(echo "$input" | jq -c '.preToolUse.parameters // {}')
fi

# Only gate git commits. Everything else passes straight through.
if [[ "$tool" != "execute_command" ]] || [[ "$cmd" != *"git commit"* ]]; then
  echo '{"cancel": false}'
  exit 0
fi

cd "$root" 2>/dev/null || { echo '{"cancel": false}'; exit 0; }

echo "GATE: running flutter analyze + flutter test before commit..."

if ! "$FLUTTER" analyze; then
  echo '{"cancel": true, "errorMessage": "BLOCKED: flutter analyze failed. Fix errors before committing."}'
  exit 0
fi

if ! "$FLUTTER" test; then
  echo '{"cancel": true, "errorMessage": "BLOCKED: flutter test failed (must be 51/51). Fix tests before committing."}'
  exit 0
fi

# The JSON must be the LAST line on stdout — Cline parses only the final JSON.
echo '{"cancel": false, "contextModification": "GATE PASSED: analyze clean, tests green."}'