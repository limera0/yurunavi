# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Rust build artifacts
/native/target/

# Flutter generated
.flutter-plugins
260604_ZoomLevel_OSM.pptx
*.pptx

# 자동 생성 l10n (소스는 lib/l10n/*.arb)
lib/src/l10n/

# Release signing — 절대 커밋 금지 (분실 시 앱 업데이트 서명 불가)
android/key.properties
android/*.jks
android/*.keystore

# google-services.json / firebase_options.dart는 더 이상 gitignore하지 않음 —
# Google 공식 정책상 이 값들은 비밀이 아님(빌드된 APK 안에 그대로 포함되므로 git에서
# 숨겨도 실제 보호 효과 없음, 진짜 보안 경계는 Firebase Security Rules/API 키 제한).
# 커밋해서 신규 체크아웃에서도 flutter analyze/build가 바로 되게 함.

# 공공데이터포털 서비스키 등 — 앱 패키지명/서명으로 바인딩되지 않는 순수 트래픽
# 쿼터 토큰이라 firebase 키와 달리 진짜 비밀임. --dart-define-from-file=env.json으로
# 빌드 시에만 주입, 절대 커밋하지 않음.
env.json

# 야간 자동화 tick 체인 스크래치 상태 (loop/run_night_auto.sh) — 매 틱 갱신되며
# git-tracked이면 브랜치 이동/머지 충돌 유발(구 loop/tick.md 상습 충돌 사례,
# loop/HANDOFF_0705_1.md:10 참고). 최종 산출물(MORNING_REPORT_*.md, HANDOFF_*.md)은
# 이 디렉토리 밖 loop/ 에 직접 써서 정상적으로 커밋됨.
loop/.auto/

# 디스코드 웹훅 URL 등 진짜 비밀 (CLAUDE.md 하드룰: 키는 전부 .env로).
.env
