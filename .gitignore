# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Rust build artifacts
/native/target/

# Flutter generated
.flutter-plugins
260604_ZoomLevel_OSM.pptx
*.pptx

# 자동 생성 l10n (소스는 lib/l10n/*.arb)
lib/src/l10n/

# Release signing — 절대 커밋 금지 (분실 시 앱 업데이트 서명 불가)
android/key.properties
android/*.jks
android/*.keystore

# google-services.json / firebase_options.dart는 더 이상 gitignore하지 않음 —
# Google 공식 정책상 이 값들은 비밀이 아님(빌드된 APK 안에 그대로 포함되므로 git에서
# 숨겨도 실제 보호 효과 없음, 진짜 보안 경계는 Firebase Security Rules/API 키 제한).
# 커밋해서 신규 체크아웃에서도 flutter analyze/build가 바로 되게 함.
