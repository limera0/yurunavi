<?xml version="1.0" encoding="utf-8"?>
<!--
  플로팅 내비게이션 오버레이 뷰
  - 72dp 정사각형, 반투명 다크 라운드 배경
  - 위: 턴 아이콘 (38dp), 아래: 거리 텍스트 (12sp)
  - FloatingOverlayService.kt에서 WindowManager.addView()로 사용
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="72dp"
    android:layout_height="72dp"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/floating_nav_bg"
    android:padding="6dp">

    <ImageView
        android:id="@+id/nav_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:src="@drawable/nav_straight"
        android:contentDescription="@null"
        android:scaleType="fitCenter"/>

    <TextView
        android:id="@+id/nav_dist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center"
        android:text=""/>

</LinearLayout>
